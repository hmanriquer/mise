        "order_folio_seq_check": {
          "name": "order_folio_seq_check",
          "value": "\"folio_seq\" > 0"
        },
        "order_business_date_check": {
          "name": "order_business_date_check",
          "value": "\"business_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "order_channel_check": {
          "name": "order_channel_check",
          "value": "\"channel\" IN ('counter', 'didi_food')"
        },
        "order_payment_method_check": {
          "name": "order_payment_method_check",
          "value": "\"payment_method\" IN ('cash', 'card_terminal', 'didi_food')"
        },
        "order_payment_for_channel_check": {
          "name": "order_payment_for_channel_check",
          "value": "(\"channel\" = 'counter' AND \"payment_method\" IN ('cash', 'card_terminal')) OR (\"channel\" = 'didi_food' AND \"payment_method\" IN ('didi_food'))"
        },
        "order_total_cents_check": {
          "name": "order_total_cents_check",
          "value": "\"total_cents\" >= 0"
        },
        "order_estimated_cost_cents_check": {
          "name": "order_estimated_cost_cents_check",
          "value": "\"estimated_cost_cents\" IS NULL OR \"estimated_cost_cents\" >= 0"
        },
        "order_cash_fields_check": {
          "name": "order_cash_fields_check",
          "value": "CASE WHEN \"payment_method\" = 'cash' THEN \"cash_received_cents\" IS NOT NULL\n    AND \"cash_received_cents\" >= \"total_cents\"\n    AND \"change_cents\" = \"cash_received_cents\" - \"total_cents\"\n    ELSE \"cash_received_cents\" IS NULL AND \"change_cents\" IS NULL END"
        },
        "order_external_ref_check": {
          "name": "order_external_ref_check",
          "value": "\"external_ref\" IS NULL OR \"channel\" = 'didi_food'"
        },
        "order_flags_check": {
          "name": "order_flags_check",
          "value": "json_valid(\"flags\") AND json_type(\"flags\") = 'array'"
        },
        "order_void_fields_check": {
          "name": "order_void_fields_check",
          "value": "(\"voided_at\" IS NULL) = (\"void_reason\" IS NULL)"
        }
      }
    },

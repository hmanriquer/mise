  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "turbo": "^2.11.11",
    "typescript": "^6.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}

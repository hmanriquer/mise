{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mise-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No database_id: wrangler finds the "mise" database by name, and `wrangler deploy` binds to it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mise",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Local dev values. deploy.yml overrides AUTH_* from the MISE_WEB_URL repository variable.
  // Secrets (BETTER_AUTH_SECRET, OWNER_BOOTSTRAP_TOKEN) come from .dev.vars or `wrangler secret`.
  "vars": {
    "APP_VERSION": "dev",
    "AUTH_RP_ID": "localhost",
    "AUTH_ORIGIN": "http://localhost:3000"
  },
  "observability": {
    "enabled": true
  }
}
